# PebbleMind Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# General Settings
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Data directory for storing application data
DATA_DIR=./data

# Cache directory for temporary files
CACHE_DIR=./cache

# ===========================================
# API Server Configuration
# ===========================================
# API server host (default: localhost for security)
API_HOST=localhost

# API server port
API_PORT=8000

# API key for authentication (generate a strong random key)
# Leave empty to disable authentication (not recommended for production)
API_KEY=your-secret-api-key-here

# CORS allowed origins (comma-separated)
# Use ["*"] for development only, specify exact origins for production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# LLM Configuration
# ===========================================
# Model name to use
MODEL_NAME=Qwen2.5-1.5B-Instruct

# Model size: 1.5b, 3b, 7b
MODEL_SIZE=1.5b

# Path to model file (leave empty for auto-detection)
MODEL_PATH=

# Maximum context length
CONTEXT_LENGTH=2048

# Maximum tokens to generate
MAX_TOKENS=256

# Sampling temperature (0.0-2.0)
TEMPERATURE=0.7

# Top-p sampling (0.0-1.0)
TOP_P=0.9

# Top-k sampling
TOP_K=40

# Number of threads (-1 for auto)
THREADS=-1

# Batch size for processing
BATCH_SIZE=256

# Enable BLAS acceleration
ENABLE_BLAS=true

# BLAS vendor (OpenBLAS, MKL, etc.)
BLAS_VENDOR=OpenBLAS

# Enable GPU offloading (false for CPU-only)
ENABLE_GPU_OFFLOAD=false

# Number of GPU layers to offload (-1 for auto, 0 for CPU-only)
GPU_LAYERS=0

# ===========================================
# RAG System Configuration
# ===========================================
# Embedding model name
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Embedding dimension
EMBEDDING_DIM=384

# Vector database path
VECTOR_DB_PATH=./data/vectors.db

# Document chunk size (in tokens)
CHUNK_SIZE=512

# Chunk overlap (in tokens)
CHUNK_OVERLAP=32

# Maximum search results
MAX_RESULTS=3

# Similarity threshold (0.0-1.0)
SIMILARITY_THRESHOLD=0.7

# ===========================================
# Voice Processing Configuration
# ===========================================
# Whisper model for speech-to-text
STT_MODEL=base.en

# Threads for STT processing
STT_THREADS=4

# Piper TTS voice model
TTS_MODEL=amy-low

# Threads for TTS processing
TTS_THREADS=4

# Audio sample rate
SAMPLE_RATE=22050

# Audio channels
CHANNELS=1

# ===========================================
# Security Configuration
# ===========================================
# Rate limiting: requests per minute
RATE_LIMIT_PER_MINUTE=60

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=25

# Session secret key for authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=your-session-secret-here

# Enable HTTPS/SSL (REQUIRED for production)
ENABLE_HTTPS=false

# SSL certificate path (required if ENABLE_HTTPS=true)
# Example: ./certs/fullchain.pem or /etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_CERT_PATH=

# SSL private key path (required if ENABLE_HTTPS=true)
# Example: ./certs/privkey.pem or /etc/letsencrypt/live/yourdomain.com/privkey.pem
SSL_KEY_PATH=

# SSL CA certificates path (optional)
# Only needed for client certificate verification
SSL_CA_CERTS=

# Enable security headers (recommended: true)
ENABLE_SECURITY_HEADERS=true

# ===========================================
# Database Configuration
# ===========================================
# Long-term memory database path
MEMORY_DB_PATH=./data/longterm_memory.db

# Database connection timeout (seconds)
DB_TIMEOUT=30.0

# Database pool size
DB_POOL_SIZE=5

# ===========================================
# Monitoring and Logging
# ===========================================
# Enable performance monitoring
ENABLE_MONITORING=true

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable error tracking (e.g., Sentry)
ENABLE_ERROR_TRACKING=false

# Sentry DSN (if error tracking enabled)
SENTRY_DSN=

# ===========================================
# Desktop Application (if using)
# ===========================================
# Window dimensions
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800

# Enable system tray icon
ENABLE_TRAY=true

# Start minimized
START_MINIMIZED=false

# ===========================================
# Development Settings
# ===========================================
# Enable debug mode (DO NOT use in production)
DEBUG=false

# Enable auto-reload on code changes
AUTO_RELOAD=false

# Enable detailed error messages
VERBOSE_ERRORS=false
